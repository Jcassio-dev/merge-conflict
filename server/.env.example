# Porta da API
PORT=8787
# Origens que podem chamar a API (CORS), separadas por vírgula.
# Local: painel (5173), mapa (5174) e https://play.workadventu.re (onde roda o
# script do mapa no "Test my map"). Em produção é o próprio domínio.
PANEL_ORIGIN=http://localhost:5173,http://localhost:5174,https://play.workadventu.re

# mock = Marina simulada, sem chave (para desenvolver e testar)
# openai-compatible = qualquer API no formato /chat/completions
#   OpenAI:  LLM_BASE_URL=https://api.openai.com/v1
#   Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Claude:  LLM_BASE_URL=https://api.anthropic.com/v1
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Modelo da avaliadora (opcional; se vazio, usa LLM_MODEL)
LLM_MODEL_AVALIADORA=
# Quanto o modelo raciocina antes de responder: minimal, low, medium ou high.
# Vazio = padrão do provedor. Menos raciocínio = resposta mais rápida e barata.
# Gemini 3 não permite desligar; o 3.8 Flash não aceita "minimal".
LLM_REASONING_EFFORT=
# Só para a avaliadora (opcional; se vazio, usa LLM_REASONING_EFFORT)
LLM_REASONING_EFFORT_AVALIADORA=
LLM_TIMEOUT_MS=30000
# Pede resposta em JSON (response_format). Desligue se o provedor não aceitar.
LLM_JSON_MODE=true

# Teto de conversas novas por hora, somando todos os jogadores (0 = sem teto).
# Cada conversa custa no máximo 8 falas + 1 relatório; o teto limita o gasto total.
LIMITE_SESSOES_POR_HORA=0
# Teto de conversas novas por hora para um mesmo jogador (0 = sem teto). Impede que
# uma pessoa sozinha gaste o teto da turma.
LIMITE_SESSOES_POR_JOGADOR_HORA=10
# Quantas avaliações independentes votam em cada relatório (nível da maioria por
# critério). 3 = mais justo e estável; 1 = mais barato. Rodam em paralelo.
VOTOS_AVALIADORA=3
# Arquivo onde o progresso dos jogadores fica guardado (id anônimo, tentativas, níveis;
# nunca a conversa). Vazio = só em memória: reiniciar a API apaga o progresso.
PROGRESSO_ARQUIVO=
# Máximo de pessoas ao mesmo tempo no escritório multiplayer (WebSocket /api/sala).
LIMITE_SALA=50
# true quando a API roda atrás de proxy reverso (no servidor, com o Traefik)
TRUST_PROXY=false

# Voz da Marina (Gemini TTS, API nativa do Google). Vazio = conversa só em texto.
# O jogador fala pelo microfone com o reconhecimento de voz do navegador (no painel).
TTS_MODEL=
# Voz pronta do Gemini (Kore: feminina, clara)
TTS_VOZ=Kore
# Chave do Google AI Studio (opcional; se vazio, usa LLM_API_KEY)
TTS_API_KEY=
TTS_TIMEOUT_MS=20000
